{
  "schema": "linroute/probe-names/1",
  "typography": {
    "probe_style": "B"
  },
  "probe_families": {
    "linclsce": {
      "tex_macro": "linclsce",
      "tex_bare": "LinClsCe",
      "caps": "LIN-CLS",
      "lower": "lin-cls",
      "mixed": "Lin-Cls",
      "in_paper": true,
      "role": "headline predictor (cross-entropy classifier probe)"
    },
    "lincls": {
      "tex_macro": "lincls",
      "tex_bare": "LinCls",
      "caps": "LIN-CLS-REG",
      "lower": "lin-cls-reg",
      "mixed": "Lin-Cls-Reg",
      "in_paper": false,
      "role": "ridge-regression probe; dropped from the paper 2026-09-23 (author: keep only probes that support a claim); still declared because unlinked sources (disabled/relational_transfer.tex, disabled/experimental_setup_old.tex under latex/iclr2027/) use the macro, and plots/bear-linearity reads this entry; its cut text is latex/iclr2027/disabled/lin-cls-reg.tex"
    },
    "linhead": {
      "tex_macro": "linhead",
      "tex_bare": "LinHead",
      "caps": "LIN-HEAD",
      "lower": "lin-head",
      "mixed": "Lin-Head",
      "in_paper": false,
      "role": "answer-state probe; dropped from the paper 2026-09-23 (author: keep only probes that support a claim); still declared because unlinked sources (disabled/relational_transfer.tex, disabled/experimental_setup_old.tex under latex/iclr2027/) use the macro"
    },
    "linlu": {
      "tex_macro": "linlu",
      "tex_bare": "LinLu",
      "caps": "LIN-LU",
      "lower": "lin-lu",
      "mixed": "Lin-Lu",
      "in_paper": true,
      "role": "prior-work probe; printed in ONE Results sentence (2026-09-23), every other passage moved to latex/iclr2027/disabled/lin-lu.tex"
    },
    "linlre": {
      "tex_macro": "linlre",
      "tex_bare": "LinLre",
      "caps": "LIN-LRE",
      "lower": "lin-lre",
      "mixed": "Lin-Lre",
      "in_paper": false,
      "role": "prior-work probe (Jacobian LRE); dropped from the paper 2026-09-23 (author: keep only probes that support a claim); still declared because unlinked sources (disabled/relational_transfer.tex, disabled/experimental_setup_old.tex under latex/iclr2027/) use the macro; its cut text is latex/iclr2027/disabled/lin-lre.tex"
    },
    "jall": {
      "tex_macro": "jall",
      "tex_bare": "JAll",
      "caps": "J-ALL",
      "lower": "j-all",
      "mixed": "J-All",
      "in_paper": false,
      "role": "lens readout; dropped from the paper 2026-09-23 (author: keep only probes that support a claim); still declared because unlinked sources (disabled/relational_transfer.tex, disabled/experimental_setup_old.tex under latex/iclr2027/) use the macro; its cut text is latex/iclr2027/disabled/lens-readouts.tex"
    },
    "logitall": {
      "tex_macro": "logitall",
      "tex_bare": "LogitAll",
      "caps": "LOGIT-ALL",
      "lower": "logit-all",
      "mixed": "Logit-All",
      "in_paper": false,
      "role": "lens readout; dropped from the paper 2026-09-23 (author: keep only probes that support a claim); still declared because unlinked sources (disabled/relational_transfer.tex, disabled/experimental_setup_old.tex under latex/iclr2027/) use the macro; its cut text is latex/iclr2027/disabled/lens-readouts.tex"
    },
    "tunedall": {
      "tex_macro": "tunedall",
      "tex_bare": "TunedAll",
      "caps": "TUNED-ALL",
      "lower": "tuned-all",
      "mixed": "Tuned-All",
      "in_paper": false,
      "role": "lens readout; dropped from the paper 2026-09-23 (author: keep only probes that support a claim); still declared because unlinked sources (disabled/relational_transfer.tex, disabled/experimental_setup_old.tex under latex/iclr2027/) use the macro; its cut text is latex/iclr2027/disabled/lens-readouts.tex"
    }
  },
  "relation_roles": {
    "prerel": {
      "tex_macro": "prerel",
      "caps": "PRE-REL",
      "lower": "pre-rel",
      "mixed": "Pre-Rel",
      "short": "pre"
    },
    "newrel": {
      "tex_macro": "newrel",
      "caps": "NEW-REL",
      "lower": "new-rel",
      "mixed": "New-Rel",
      "short": "new"
    }
  },
  "metrics": {
    "lincls_ce_gain": {
      "tex_macro": "clsMetricPlain",
      "tex_body_kind": "textrm",
      "plain": "{terms.$.gain.plain}",
      "axis_label": "{terms.$.gain.axis}",
      "axis_short_label": "{terms.$.gain.plain}"
    },
    "newrelgen": {
      "tex_macro": "newrelgen",
      "tex_body_kind": "textrm",
      "plain": "{terms.$.generalization.plain}",
      "axis_label": "{terms.$.generalization.axis}",
      "axis_short_label": "{terms.$.generalization.plain}"
    },
    "candacc": {
      "tex_macro": "candacc",
      "tex_body_kind": "textrm",
      "plain": "{terms.$.candacc.plain}"
    },
    "preanstok": {
      "tex_macro": "preanstok",
      "tex_body_kind": "textrm",
      "plain": "PRE-ANS-TOK"
    },
    "newanstok": {
      "tex_macro": "newanstok",
      "tex_body_kind": "textrm",
      "plain": "NEW-ANS-TOK"
    }
  },
  "controls": {
    "recall": {
      "tex_macro_header": "ctrlRecallHeader",
      "tex_macro_prose": "ctrlRecallProse",
      "header": "Recall",
      "prose": "accuracy on the pretrained relation"
    },
    "answer_count": {
      "tex_macro_header": "ctrlAnswerCountHeader",
      "tex_macro_prose": "ctrlAnswerCountProse",
      "header": "Answer count",
      "prose": "the logarithm of the number of distinct answers"
    },
    "subject_count": {
      "tex_macro_header": "ctrlSubjectCountHeader",
      "tex_macro_prose": "ctrlSubjectCountProse",
      "header": "Subject count",
      "prose": "the logarithm of the number of training subjects"
    },
    "subject_frequency": {
      "tex_macro_header": "ctrlFreqHeader",
      "tex_macro_prose": "ctrlFreqProse",
      "header": "Subject frequency",
      "prose": "subject-mention frequency in the queried corpus"
    },
    "all_jointly": {
      "tex_macro_header": "ctrlAllHeader",
      "tex_macro_prose": "ctrlAllProse",
      "header": "All jointly",
      "prose": "all four covariates at once"
    }
  },
  "terms": {
    "active": "readable",
    "readable_casing": "sentence",
    "technical": {
      "gain": {
        "plain": "LIN-CLS",
        "short": "LIN-CLS",
        "axis": "Pretrained LIN-CLS s₀ PRE-REL | q=16 gain",
        "tex_macro": "termGainShort",
        "tex_form": "short"
      },
      "recall": {
        "plain": "{relation_roles.prerel.caps} {metrics.candacc.plain}",
        "short": "recall",
        "tex_macro": "termRecallShort",
        "tex_form": "short",
        "tex_macro_plain": "termRecallPlain"
      },
      "candacc": {
        "plain": "CAND-ACC"
      },
      "prerel": {
        "plain": "PRE-REL",
        "tex_macro": "termPreRel",
        "tex_form": "plain"
      },
