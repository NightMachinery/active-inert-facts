        "plain": "NEW-REL",
        "tex_macro": "termNewRelShort",
        "tex_form": "plain"
      },
      "generalization": {
        "plain": "NEW-REL-GEN",
        "axis": "NEW-REL-GEN (macro CAND-ACC on H)"
      }
    },
    "readable": {
      "gain": {
        "plain": "Pre-linearity",
        "short": "Pre-linearity",
        "axis": "Pre-linearity",
        "tex_macro": "termGainShort",
        "tex_form": "short"
      },
