        "plain": "PRE-REL",
        "tex_macro": "termPreRelAdj",
        "tex_form": "plain"
      },
      "prerel_head": {
        "plain": "PRE-REL",
        "tex_macro": "termPreRelHead",
        "tex_form": "plain"
      },
      "newrel": {
        "plain": "NEW-REL",
        "tex_macro": "termNewRel",
        "tex_form": "plain"
      },
      "newrel_adj": {
        "plain": "NEW-REL",
        "tex_macro": "termNewRelAdj",
        "tex_form": "plain"
      },
      "newrel_head": {
        "plain": "NEW-REL",
        "tex_macro": "termNewRelHead",
        "tex_form": "plain"
      },
